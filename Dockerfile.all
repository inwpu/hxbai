FROM kalilinux/kali-rolling:latest

ENV DEBIAN_FRONTEND=noninteractive PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 \
    NODE_VERSION=20.18.1 LANG=C.UTF-8


RUN rm -f /etc/apt/sources.list.d/*.list /etc/apt/sources.list.d/*.sources 2>/dev/null; \
    printf 'deb http://mirrors.bfsu.edu.cn/kali kali-rolling main non-free non-free-firmware contrib\ndeb http://mirrors.ustc.edu.cn/kali kali-rolling main non-free non-free-firmware contrib\ndeb http://mirrors.aliyun.com/kali kali-rolling main non-free non-free-firmware contrib\ndeb http://http.kali.org/kali kali-rolling main non-free non-free-firmware contrib\n' \
        > /etc/apt/sources.list && \
    printf '[global]\nindex-url = https://mirrors.bfsu.edu.cn/pypi/web/simple\nextra-index-url = https://mirrors.ustc.edu.cn/pypi/web/simple\nretries = 8\ntimeout = 60\n[install]\ntrusted-host = mirrors.bfsu.edu.cn\n               mirrors.ustc.edu.cn\n               mirrors.aliyun.com\n' \
        > /etc/pip.conf && \
    printf 'Acquire::Retries "3";\nAcquire::http::Timeout "25";\nAcquire::https::Timeout "25";\nAcquire::http::Pipeline-Depth "0";\nAcquire::Languages "none";\n' \
        > /etc/apt/apt.conf.d/80-retries

RUN echo "wireshark-common wireshark-common/install-setuid boolean false" | debconf-set-selections; \
    set -eux; for i in 1 2 3 4 5; do \
        apt-get update && apt-get install -y --no-install-recommends --fix-missing \
            python3 python3-pip python3-venv \
            curl wget git ca-certificates gnupg xz-utils unzip zip xxd file jq ripgrep \
            nmap masscan ffuf gobuster dirb nikto whatweb \
            dnsutils iputils-ping net-tools netcat-traditional ncat socat proxychains4 tmux rlwrap sshpass openssh-client \
            gdb gdb-multiarch radare2 binutils patchelf cpio qemu-user-static ruby ruby-dev build-essential \
            strace ltrace upx-ucl tcpdump \
            hydra john hashcat \
            tshark binwalk foremost exiftool steghide sleuthkit poppler-utils mono-mcs \
            squashfs-tools tesseract-ocr tesseract-ocr-eng \
            redis-tools default-mysql-client postgresql-client php-cli \
            cmake pkg-config \
            python3-z3 python3-pwntools python3-pycryptodome python3-scipy python3-pil python3-lxml python3-scapy python3-gmpy2 \
            python3-sympy python3-impacket python3-boto3 python3-bs4 \
            default-jdk-headless openvpn openssl \
        && break || { echo "apt attempt $i failed; retry"; sleep 12; }; \
    done

RUN set -eux; \
    for pkg in jadx apktool aapt apksigner zipalign adb dex2jar; do \
        for i in 1 2 3; do apt-get install -y --no-install-recommends "$pkg" && break || sleep 6; done \
        || echo "mobile pkg skipped: $pkg"; \
    done

RUN apt-get install -y --no-install-recommends --fix-missing \
        -o Acquire::Retries=1 -o Acquire::http::Timeout=20 seclists \
    || echo "seclists apt skipped (using direct-wget essentials)"; \
    mkdir -p /usr/share/wordlists/api; \
    B=https://raw.githubusercontent.com/danielmiessler/SecLists/master/Discovery/Web-Content; \
    for f in common.txt raft-medium-directories.txt raft-medium-files.txt burp-parameter-names.txt; do \
        [ -s "/usr/share/wordlists/$f" ] || for i in 1 2 3; do wget -q -O "/usr/share/wordlists/$f" "$B/$f" && break || sleep 4; done; done; \
    [ -s /usr/share/wordlists/api/api-endpoints.txt ] || wget -q -O /usr/share/wordlists/api/api-endpoints.txt "$B/api/api-endpoints.txt" || true; \
    [ -e /usr/share/seclists/Discovery/Web-Content ] || { mkdir -p /usr/share/seclists/Discovery && ln -sfn /usr/share/wordlists /usr/share/seclists/Discovery/Web-Content; }; \
    WL=$(wc -l < /usr/share/wordlists/raft-medium-directories.txt 2>/dev/null || echo 0); echo "wordlists: raft-dirs=${WL} lines"; \
    [ "${WL}" -gt 100 ] || echo "!!! WARNING wordlists EMPTY — dir brute-forcing crippled"

RUN set -eux; mkdir -p /opt/tools /usr/share/wordlists; \
    (for U in "https://raw.githubusercontent.com/synacktiv/php_filter_chain_generator/main/php_filter_chain_generator.py" \
              "https://gh-proxy.com/https://raw.githubusercontent.com/synacktiv/php_filter_chain_generator/main/php_filter_chain_generator.py"; do \
        wget -q -T 20 -O /opt/tools/php_filter_chain_generator.py "$U" && [ -s /opt/tools/php_filter_chain_generator.py ] && break || rm -f /opt/tools/php_filter_chain_generator.py; done; \
     [ -s /opt/tools/php_filter_chain_generator.py ] && chmod +x /opt/tools/php_filter_chain_generator.py && ln -sf /opt/tools/php_filter_chain_generator.py /usr/local/bin/php_filter_chain_generator.py || echo "php_filter_chain_generator skipped"); \
    (for U in "https://raw.githubusercontent.com/danielmiessler/SecLists/master/Passwords/Leaked-Databases/rockyou.txt.tar.gz" \
              "https://gh-proxy.com/https://raw.githubusercontent.com/danielmiessler/SecLists/master/Passwords/Leaked-Databases/rockyou.txt.tar.gz"; do \
        wget -q -T 60 -O /tmp/rockyou.tar.gz "$U" && [ -s /tmp/rockyou.tar.gz ] && break || rm -f /tmp/rockyou.tar.gz; done; \
     if [ -s /tmp/rockyou.tar.gz ]; then \
        tar -xzf /tmp/rockyou.tar.gz -C /tmp && head -n 1000000 /tmp/rockyou.txt > /usr/share/wordlists/rockyou-top1m.txt; \
        rm -f /tmp/rockyou.tar.gz /tmp/rockyou.txt; \
        ln -sf /usr/share/wordlists/rockyou-top1m.txt /usr/share/wordlists/rockyou.txt; \
        echo "rockyou-top1m lines: $(wc -l < /usr/share/wordlists/rockyou-top1m.txt)"; \
     else echo "rockyou skipped (degraded, not fatal)"; fi)

RUN set -eux; arch="$(uname -m)"; case "$arch" in x86_64) NA=x64;; aarch64|arm64) NA=arm64;; *) NA=x64;; esac; \
    if ! command -v wget >/dev/null 2>&1 && ! command -v curl >/dev/null 2>&1; then \
        echo "[node] wget/curl 均缺失(上游 apt 步骤 --fix-missing 在差网络下会静默跳包)——自装(带重试,不用 --fix-missing)"; \
        for i in 1 2 3; do \
            apt-get update && apt-get install -y --no-install-recommends wget curl ca-certificates xz-utils && break || sleep 5; \
        done; \
        command -v wget >/dev/null 2>&1 || command -v curl >/dev/null 2>&1 \
            || { echo "FATAL: 自装 wget/curl 失败——apt 源不可达(检查网络/代理,或 docker build --build-arg HTTPS_PROXY=...)"; exit 1; }; \
    fi; \
    TB="node-v${NODE_VERSION}-linux-${NA}.tar.xz"; ok=0; \
    for U in "https://mirrors.bfsu.edu.cn/nodejs-release/v${NODE_VERSION}/${TB}" \
             "https://mirrors.ustc.edu.cn/node/v${NODE_VERSION}/${TB}" \
             "https://mirrors.aliyun.com/nodejs-release/v${NODE_VERSION}/${TB}" \
             "https://nodejs.org/dist/v${NODE_VERSION}/${TB}"; do \
        if command -v wget >/dev/null 2>&1; then wget -q -T 30 -O /tmp/node.tar.xz "$U"; \
        else curl -fsSL --max-time 90 -o /tmp/node.tar.xz "$U"; fi \
        && tar -tJf /tmp/node.tar.xz >/dev/null 2>&1 && { ok=1; break; } || { rm -f /tmp/node.tar.xz; sleep 3; }; \
    done; \
    [ "$ok" = 1 ] || { echo "FATAL: Node tarball 从全部镜像拉取失败(检查网络/代理,或手动 docker build --build-arg HTTPS_PROXY=...)"; exit 1; }; \
    tar -xJf /tmp/node.tar.xz -C /usr/local --strip-components=1; rm -f /tmp/node.tar.xz; \
    node --version

RUN for spec in "requests" "httpx[socks]" "PyYAML" "python-dotenv" "openai" "zai-sdk"; do \
        pip3 install --break-system-packages "$spec" \
        || pip3 install --break-system-packages -i https://mirrors.ustc.edu.cn/pypi/web/simple "$spec" \
        || pip3 install --break-system-packages -i https://mirrors.aliyun.com/pypi/simple/ "$spec" \
        || pip3 install --break-system-packages -i https://pypi.org/simple "$spec" \
        || echo "pip skip: $spec"; \
    done
RUN for p in pwntools pycryptodome sympy gmpy2 z3-solver impacket boto3 awscli beautifulsoup4 requests; do \
        pip3 install --break-system-packages "$p" \
            || pip3 install --break-system-packages --ignore-installed -i https://mirrors.aliyun.com/pypi/simple/ "$p" \
            || echo "pip skip: $p (apt layer above is the primary source)"; \
    done
RUN for p in mmh3 ecdsa jwcrypto; do \
        pip3 install --break-system-packages "$p" \
            || pip3 install --break-system-packages --ignore-installed "$p" \
            || echo "cybench lib skipped: $p"; \
    done
RUN for p in capstone unicorn numpy scipy lxml scapy pillow pyasn1 pefile xdis dnfile python-registry regipy web3 eth-account pyevmasm psycopg2-binary; do \
        pip3 install --break-system-packages "$p" \
            || pip3 install --break-system-packages --ignore-installed -i https://mirrors.aliyun.com/pypi/simple/ "$p" \
            || echo "pip skip: $p (apt layer above covers the core)"; \
    done
RUN pip3 install --break-system-packages androguard frida-tools objection \
    || echo "mobile py libs partially skipped (static path still works)"; \
    pip3 install --break-system-packages 'websockets>=14' \
    || echo "websockets re-pin skipped (web3 WS provider degraded)"
RUN pip3 install --break-system-packages semgrep bandit || echo "semgrep/bandit skipped"
RUN pip3 install --break-system-packages cysignals fpylll || echo "fpylll skipped (lattice)"
RUN pip3 install --break-system-packages angr \
    || pip3 install --break-system-packages --ignore-installed angr \
    || echo "angr skipped (z3 covers most)"
RUN pip3 install --break-system-packages volatility3 mitmproxy || echo "volatility3/mitmproxy skipped"
RUN pip3 install --break-system-packages slither-analyzer py-solc-x || echo "slither/solcx skipped"

RUN gem sources --clear-all >/dev/null 2>&1 || true; \
    gem sources --add https://mirrors.bfsu.edu.cn/rubygems/ \
                --add https://mirrors.ustc.edu.cn/rubygems/ \
                --add https://mirrors.aliyun.com/rubygems/ \
                --remove https://rubygems.org/ >/dev/null 2>&1 || true; \
    gem sources -l; \
    gem install one_gadget seccomp-tools 2>/dev/null || echo "one_gadget/seccomp-tools skipped"; \
    gem install zsteg --no-document 2>/dev/null || echo "zsteg skipped"

ARG TOOLS_REFRESH=20261015b
RUN set -eux; echo "tools-refresh=${TOOLS_REFRESH}"; mkdir -p /opt/tools; \
    (for U in "https://github.com/Giotino/stegsolve/releases/download/v1.4/StegSolve-1.4.jar" \
              "https://gh-proxy.com/https://github.com/Giotino/stegsolve/releases/download/v1.4/StegSolve-1.4.jar" \
              "http://www.caesum.com/handbook/Stegsolve.jar"; do \
        wget -q -T 15 -O /opt/tools/stegsolve.jar "$U" && [ -s /opt/tools/stegsolve.jar ] && break || rm -f /opt/tools/stegsolve.jar; done; \
     [ -s /opt/tools/stegsolve.jar ] && printf '#!/bin/sh\nexec java -jar /opt/tools/stegsolve.jar "$@"\n' > /usr/local/bin/stegsolve \
       && chmod +x /usr/local/bin/stegsolve) || echo "stegsolve skipped"; \
    (curl -fsSL https://dot.net/v1/dotnet-install.sh -o /tmp/dotnet-install.sh \
      && bash /tmp/dotnet-install.sh --channel 8.0 --install-dir /usr/share/dotnet >/dev/null \
      && ln -sf /usr/share/dotnet/dotnet /usr/local/bin/dotnet \
      && DOTNET_ROOT=/usr/share/dotnet dotnet tool install --global ilspycmd --version 8.2.0.7535 \
      && ln -sf /root/.dotnet/tools/ilspycmd /usr/local/bin/ilspycmd \
      && rm -f /tmp/dotnet-install.sh) || echo "dotnet/ilspycmd skipped (~220MB, needs network)"
ENV DOTNET_ROOT=/usr/share/dotnet

RUN set -eux; arch="$(uname -m)"; case "$arch" in x86_64) GA=amd64;; aarch64|arm64) GA=arm64;; *) GA=amd64;; esac; \
    mkdir -p /opt/tools; \
    (cv=1.10.1; for i in 1 2 3; do wget -q -O /tmp/chisel.gz "https://github.com/jpillora/chisel/releases/download/v${cv}/chisel_${cv}_linux_${GA}.gz" \
        && gunzip -c /tmp/chisel.gz > /usr/local/bin/chisel && chmod +x /usr/local/bin/chisel && rm -f /tmp/chisel.gz && break || sleep 3; done; command -v chisel) || echo "chisel skipped"; \
    (cf=2.0.5; for U in "https://github.com/BishopFox/cloudfox/releases/download/v${cf}/cloudfox-linux-${GA}.zip" "https://gh-proxy.com/https://github.com/BishopFox/cloudfox/releases/download/v${cf}/cloudfox-linux-${GA}.zip"; do \
        for i in 1 2 3; do wget -q -O /tmp/cf.zip "$U" && unzip -q -o /tmp/cf.zip -d /tmp/cf && install -m0755 "$(find /tmp/cf -name cloudfox -type f | head -1)" /usr/local/bin/cloudfox && rm -rf /tmp/cf.zip /tmp/cf && break 2 || { rm -rf /tmp/cf.zip /tmp/cf; sleep 3; }; done; done; command -v cloudfox) || echo "cloudfox skipped"; \
    (wget -q -O /opt/tools/ysoserial.jar "https://github.com/frohoff/ysoserial/releases/latest/download/ysoserial-all.jar") || echo "ysoserial skipped"; \
    (for U in "https://github.com/RandomRobbieBF/marshalsec-jar/raw/main/marshalsec-0.0.3-SNAPSHOT-all.jar" \
              "https://gh-proxy.com/https://github.com/RandomRobbieBF/marshalsec-jar/raw/main/marshalsec-0.0.3-SNAPSHOT-all.jar"; do \
        wget -q -O /opt/tools/marshalsec.jar "$U" && [ -s /opt/tools/marshalsec.jar ] && break || rm -f /opt/tools/marshalsec.jar; done; [ -s /opt/tools/marshalsec.jar ]) || echo "marshalsec skipped"; \
    (for U in "https://github.com/welk1n/JNDI-Injection-Exploit/releases/download/v1.0/JNDI-Injection-Exploit-1.0-SNAPSHOT-all.jar" \
              "https://gh-proxy.com/https://github.com/welk1n/JNDI-Injection-Exploit/releases/download/v1.0/JNDI-Injection-Exploit-1.0-SNAPSHOT-all.jar"; do \
        wget -q -O /opt/tools/JNDI-Injection-Exploit.jar "$U" && [ -s /opt/tools/JNDI-Injection-Exploit.jar ] && break || rm -f /opt/tools/JNDI-Injection-Exploit.jar; done; [ -s /opt/tools/JNDI-Injection-Exploit.jar ]) || echo "JNDI-Injection-Exploit skipped"; \
    (git clone --depth 1 https://github.com/ticarpi/jwt_tool /opt/tools/jwt_tool) || echo "jwt_tool skipped"; \
    (cd=v1.5.2; wget -q -O /usr/local/bin/cdk "https://github.com/cdk-team/CDK/releases/download/${cd}/cdk_linux_${GA}" && chmod +x /usr/local/bin/cdk) || echo "cdk skipped"; \
    (nv=3.11.1; for i in 1 2 3; do wget -q -O /tmp/nuclei.zip "https://github.com/projectdiscovery/nuclei/releases/download/v${nv}/nuclei_${nv}_linux_${GA}.zip" \
        && unzip -q -o /tmp/nuclei.zip -d /usr/local/bin nuclei && chmod +x /usr/local/bin/nuclei && rm -f /tmp/nuclei.zip && break || sleep 5; done; nuclei -version 2>&1 | head -1) || echo "nuclei binary skipped"; \
    (for i in 1 2 3; do nuclei -update-templates 2>&1 | tail -1 && break || sleep 8; done); \
    NT=$(find /root/nuclei-templates -name '*.yaml' 2>/dev/null | wc -l); echo "nuclei-templates: ${NT} yaml"; \
    [ "${NT}" -gt 3000 ] || echo "!!! WARNING nuclei-templates EMPTY/THIN (${NT})"

RUN (wget -q -O /root/.gdbinit-gef.py https://raw.githubusercontent.com/hugsy/gef/main/gef.py \
      && echo "source /root/.gdbinit-gef.py" > /root/.gdbinit) || echo "gef skipped"
RUN (pip3 install --break-system-packages playwright && python3 -m playwright install --with-deps chromium) || echo "playwright/chromium skipped"

RUN set -eux; GV=11.2.1; GD=20241105; \
    ( for U in "https://github.com/NationalSecurityAgency/ghidra/releases/download/Ghidra_${GV}_build/ghidra_${GV}_PUBLIC_${GD}.zip" \
               "https://gh-proxy.com/https://github.com/NationalSecurityAgency/ghidra/releases/download/Ghidra_${GV}_build/ghidra_${GV}_PUBLIC_${GD}.zip"; do \
        for i in 1 2 3; do wget -q -O /tmp/ghidra.zip "$U" && unzip -q -o /tmp/ghidra.zip -d /opt && break 2 || { rm -f /tmp/ghidra.zip; sleep 5; }; done; done; \
      mv /opt/ghidra_${GV}_PUBLIC /opt/ghidra && ln -sf /opt/ghidra/support/analyzeHeadless /usr/local/bin/analyzeHeadless && rm -f /tmp/ghidra.zip \
      && test -x /opt/ghidra/support/analyzeHeadless ) || echo "ghidra skipped (r2 fallback)"

RUN set -eux; mkdir -p /tmp/grs; \
    (gv=3.4; for U in "https://github.com/mandiant/GoReSym/releases/download/v${gv}/GoReSym-linux.zip" \
        "https://gh-proxy.com/https://github.com/mandiant/GoReSym/releases/download/v${gv}/GoReSym-linux.zip"; do \
        for i in 1 2 3; do wget -q -O /tmp/grs.zip "$U" && unzip -q -o /tmp/grs.zip -d /tmp/grs \
            && install -m0755 "$(find /tmp/grs -type f -name 'GoReSym*' ! -name '*.zip' | head -1)" /usr/local/bin/GoReSym \
            && break 2 || { rm -rf /tmp/grs.zip /tmp/grs/*; sleep 4; }; done; done; \
      rm -rf /tmp/grs.zip /tmp/grs; command -v GoReSym) || echo "GoReSym skipped"

RUN set -eux; arch="$(uname -m)"; case "$arch" in x86_64) GA=amd64;; aarch64|arm64) GA=arm64;; *) GA=amd64;; esac; \
    (gv=2.63.2; for U in "https://github.com/cli/cli/releases/download/v${gv}/gh_${gv}_linux_${GA}.tar.gz" \
        "https://gh-proxy.com/https://github.com/cli/cli/releases/download/v${gv}/gh_${gv}_linux_${GA}.tar.gz"; do \
        for i in 1 2 3; do wget -q -O /tmp/gh.tgz "$U" && tar -xzf /tmp/gh.tgz -C /tmp && install -m0755 "$(find /tmp -name gh -type f -path '*/bin/*'|head -1)" /usr/local/bin/gh && rm -rf /tmp/gh.tgz && break 2 || sleep 4; done; done; command -v gh) || echo "gh skipped"

RUN set -eux; arch="$(uname -m)"; case "$arch" in x86_64) FA=amd64;; aarch64|arm64) FA=arm64;; *) FA=amd64;; esac; \
    V=v1.7.1; TB="foundry_${V}_linux_${FA}.tar.gz"; \
    ( for U in "https://github.com/foundry-rs/foundry/releases/download/${V}/${TB}" \
               "https://gh-proxy.com/https://github.com/foundry-rs/foundry/releases/download/${V}/${TB}"; do \
        for i in 1 2 3; do wget -q -O /tmp/foundry.tgz "$U" && tar -tzf /tmp/foundry.tgz >/dev/null 2>&1 && break 2 || { rm -f /tmp/foundry.tgz; sleep 3; }; done; \
      done; \
      tar -xzf /tmp/foundry.tgz -C /usr/local/bin forge cast anvil && rm -f /tmp/foundry.tgz \
      && forge --version && cast --version ) || echo "foundry skipped (web3.py fallback)"

RUN for i in 1 2 3; do apt-get install -y --no-install-recommends -o Acquire::Retries=2 sqlmap && break || sleep 8; done; \
    command -v sqlmap || pip3 install --break-system-packages sqlmap || echo "sqlmap unavailable"

RUN pip3 install --break-system-packages rapidocr-onnxruntime onnxruntime opencv-python-headless \
    && python3 -c "from rapidocr_onnxruntime import RapidOCR; RapidOCR()" \
    || echo "rapidocr skipped (tesseract remains the OCR floor)"

RUN for i in 1 2 3; do apt-get install -y --no-install-recommends -o Acquire::Retries=2 cmake pkg-config && break || sleep 6; done; \
    for pe in pwn:pwntools Crypto:pycryptodome sympy:sympy gmpy2:gmpy2 z3:z3-solver impacket:impacket; do \
        m=${pe%%:*}; p=${pe##*:}; \
        python3 -c "import $m" 2>/dev/null || pip3 install --break-system-packages --retries 5 "$p" \
        || echo "gap-fill pip skipped: $p"; done; \
    python3 -c "import pwn" && echo "pwntools OK" || echo "!!! pwntools STILL missing"

RUN command -v d2j-dex2jar.sh >/dev/null 2>&1 || { \
        for U in "https://github.com/pxb1988/dex2jar/releases/download/v2.4/dex-tools-v2.4.zip" \
                 "https://gh-proxy.com/https://github.com/pxb1988/dex2jar/releases/download/v2.4/dex-tools-v2.4.zip"; do \
            wget -q -O /tmp/d2j.zip "$U" && unzip -q -o /tmp/d2j.zip -d /opt && break || rm -f /tmp/d2j.zip; done; \
        D=$(find /opt -maxdepth 1 -type d -name 'dex-tools-*' | head -1); \
        if [ -n "$D" ]; then chmod +x "$D"/*.sh 2>/dev/null || true; \
            for s in "$D"/d2j-*.sh; do [ -f "$s" ] && ln -sf "$s" /usr/local/bin/"$(basename "$s")"; done; fi; \
        rm -f /tmp/d2j.zip; }; \
    command -v d2j-dex2jar.sh >/dev/null 2>&1 && echo "dex2jar OK" || echo "dex2jar still missing (jadx/apktool cover mobile RE)"

ARG KB_MARCIO=0
ARG KB_TRICKEST=0
ARG KB_REFRESH=20261015b
RUN set -eux; echo "kb-refresh=${KB_REFRESH}"; mkdir -p /opt/kb; \
    clone_kb() { dst="$1"; repo="$2"; min="$3"; \
        for U in "https://github.com/${repo}.git" "https://gh-proxy.com/https://github.com/${repo}.git"; do \
            for i in 1 2 3; do rm -rf "/opt/kb/${dst}"; git clone --depth 1 "$U" "/opt/kb/${dst}" && break 2 || sleep 5; done; \
        done; \
        rm -rf "/opt/kb/${dst}/.git" 2>/dev/null || true; \
        n=$(find "/opt/kb/${dst}" -type f 2>/dev/null | wc -l); echo "kb ${dst}: ${n} files"; \
        [ "${n}" -gt "${min}" ] || echo "!!! kb ${dst} EMPTY/THIN (${n} <= ${min})"; }; \
    clone_kb vulhub               vulhub/vulhub                 500 || true; \
    clone_kb PayloadsAllTheThings swisskyrepo/PayloadsAllTheThings 400 || true; \
    clone_kb awesome-poc          Threekiii/Awesome-POC         300 || true; \
    clone_kb exphub               zhzyker/exphub                 60 || true; \
    [ "${KB_MARCIO}" = "1" ] && clone_kb marcio-cve 0xMarcio/cve 200 || echo "marcio-cve skipped (ARG KB_MARCIO=1 to include)"; \
    [ "${KB_TRICKEST}" = "1" ] && clone_kb trickest-cve trickest/cve 5000 || echo "trickest-cve skipped (ARG KB_TRICKEST=1 to include)"; \
    find /opt/kb -type f ! -name INDEX.txt \
        \( -name '*.md' -o -name '*.py' -o -name '*.txt' -o -name '*.yaml' -o -name '*.json' \) \
        | sed 's|^/opt/kb/||' | sort > /tmp/kb_index.txt; \
    mv /tmp/kb_index.txt /opt/kb/INDEX.txt; \
    echo "kb INDEX: $(wc -l < /opt/kb/INDEX.txt) knowledge files"

RUN set -eux; \
    case "$(uname -m)" in \
      x86_64) A=x64;   H=26d020351e8112f4006790f3cfce43b4c9df0c1bb1d0e542364d64151b81d5ba ;; \
      aarch64|arm64) A=arm64; H=7d25d7c8ae6c6e009cc7dae4e817f674179fd31fb7761bcd56fee4c2902b4c03 ;; \
      *) echo "unsupported arch $(uname -m)"; exit 1 ;; \
    esac; \
    B=/tmp/claude-${A}; \
    for i in $(seq 1 20); do curl -fsSL -m 240 -C - -o "${B}" "https://downloads.claude.ai/claude-code-releases/2.1.263/linux-${A}/claude" && break; sleep 3; done; \
    echo "${H}  ${B}" | sha256sum -c -; \
    install -m 0755 "${B}" /usr/local/bin/claude; \
    rm -rf "${B}"; \
    claude --version && echo "claude native binary OK"

RUN [ -s /opt/tools/marshalsec.jar ] || for U in \
        "https://github.com/RandomRobbieBF/marshalsec-jar/raw/main/marshalsec-0.0.3-SNAPSHOT-all.jar" \
        "https://gh-proxy.com/https://github.com/RandomRobbieBF/marshalsec-jar/raw/main/marshalsec-0.0.3-SNAPSHOT-all.jar" \
        "https://ghproxy.net/https://github.com/RandomRobbieBF/marshalsec-jar/raw/main/marshalsec-0.0.3-SNAPSHOT-all.jar"; do \
        wget -q -O /opt/tools/marshalsec.jar "$U" && [ -s /opt/tools/marshalsec.jar ] && break || rm -f /opt/tools/marshalsec.jar; done; \
    if [ ! -s /opt/tools/marshalsec.jar ]; then \
        echo "marshalsec prebuilt mirrors failed -> building from source (needs JDK 8)"; \
        (apt-get install -y --no-install-recommends maven || true); \
        for U in "https://api.adoptium.net/v3/binary/latest/8/ga/linux/x64/jdk/hotspot/normal/eclipse" \
                 "https://gh-proxy.com/https://github.com/adoptium/temurin8-binaries/releases/download/jdk8u422-b05/OpenJDK8U-jdk_x64_linux_hotspot_8u422b05.tar.gz"; do \
            wget -q -O /tmp/jdk8.tgz "$U" && tar -tzf /tmp/jdk8.tgz >/dev/null 2>&1 && break || rm -f /tmp/jdk8.tgz; done; \
        mkdir -p /opt/jdk8 && tar -xzf /tmp/jdk8.tgz -C /opt/jdk8 --strip-components=1 && rm -f /tmp/jdk8.tgz; \
        for G in "https://gh-proxy.com/https://github.com/mbechler/marshalsec.git" \
                 "https://github.com/mbechler/marshalsec.git"; do \
            rm -rf /tmp/marshalsec; git clone --depth 1 "$G" /tmp/marshalsec && break || rm -rf /tmp/marshalsec; done; \
        (cd /tmp/marshalsec && JAVA_HOME=/opt/jdk8 PATH=/opt/jdk8/bin:$PATH \
            mvn -q -B -Dmaven.test.skip=true -Denforcer.skip=true clean package \
            && cp target/marshalsec-0.0.3-SNAPSHOT-all.jar /opt/tools/marshalsec.jar) || echo "marshalsec source build failed"; \
        rm -rf /tmp/marshalsec /root/.m2 /opt/jdk8; \
    fi; \
    [ -s /opt/tools/marshalsec.jar ] && echo "marshalsec OK" || echo "marshalsec still missing (ysoserial covers most)"

RUN pip3 install --break-system-packages --ignore-installed \
        'cryptography>=49' 'websockets>=14' 'unicorn>=2.0.1,!=2.1.3,!=2.1.4' \
    || echo "dep settlement partially skipped (resolver warnings may remain)"

RUN rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/*.deb 2>/dev/null || true

RUN set -eu; log=/opt/tools/BUILD_SELFCHECK.txt; : > "$log"; missing_p0=""; \
    p0_bin="node python3 curl wget git jq rg nmap ffuf gobuster sqlmap nikto whatweb tshark binwalk foremost exiftool steghide xxd zip unzip file gdb radare2 objdump strings hydra john socat ncat proxychains4 tmux openvpn java unsquashfs tesseract redis-cli psql php nc ssh sshpass"; \
    opt_bin="jadx apktool aapt apksigner zipalign adb d2j-dex2jar.sh mysql mariadb hashcat chisel nuclei cloudfox cdk gh analyzeHeadless forge cast anvil gdb-multiarch tcpdump masscan zsteg stegsolve mcs mono ilspycmd GoReSym"; \
    for b in $p0_bin; do if command -v "$b" >/dev/null 2>&1; then echo "P0 bin OK   $b" >>"$log"; else echo "P0 bin MISS $b" >>"$log"; missing_p0="$missing_p0 $b"; fi; done; \
    if claude --version >/dev/null 2>&1; then echo "P0 claude OK ($(claude --version 2>&1 | head -1))" >>"$log"; else echo "P0 claude MISS (native binary broken)" >>"$log"; missing_p0="$missing_p0 claude"; fi; \
    for b in $opt_bin; do if command -v "$b" >/dev/null 2>&1; then echo "opt bin OK  $b" >>"$log"; else echo "opt bin warn $b (degraded)" >>"$log"; fi; done; \
    for j in ysoserial marshalsec JNDI-Injection-Exploit; do if [ -s "/opt/tools/$j.jar" ]; then echo "jar OK   $j" >>"$log"; else echo "jar warn $j (degraded)" >>"$log"; fi; done; \
    for m in Crypto z3 pwn PIL scapy lxml scipy sympy impacket; do if python3 -c "import $m" >/dev/null 2>&1; then echo "py OK   $m" >>"$log"; else echo "py MISS $m" >>"$log"; missing_p0="$missing_p0 py:$m"; fi; done; \
    for m in web3 rapidocr_onnxruntime requests httpx yaml openai; do if python3 -c "import $m" >/dev/null 2>&1; then echo "py OK   $m" >>"$log"; else echo "py warn $m (degraded)" >>"$log"; fi; done; \
    echo "--- kb corpora ---" >>"$log"; ls /opt/kb >>"$log" 2>&1 || true; \
    KB=$(wc -l < /opt/kb/INDEX.txt 2>/dev/null || echo 0); echo "kb INDEX: ${KB} files" >>"$log"; \
    [ "${KB}" -gt 2000 ] || echo "!!! WARNING kb INDEX THIN (${KB}) — offline PoC lookup degraded" >>"$log"; \
    echo "==== SELF-CHECK SUMMARY ====" >>"$log"; \
    if [ -n "$missing_p0" ]; then echo "P0 MISSING:$missing_p0" >>"$log"; cat "$log"; echo "!!! BUILD FAILED: P0 tools missing:$missing_p0"; exit 1; fi; \
    echo "ALL P0 PRESENT" >>"$log"; cat "$log"

ENV IS_SANDBOX=1 TERM=xterm

WORKDIR /app
RUN (apt-get update && apt-get install -y --no-install-recommends -o Acquire::Retries=2 sqlite3) \
      || echo "sqlite3 CLI skipped (debug-only; program uses python sqlite3 module, unaffected)"
RUN (apt-get update -o Acquire::Retries=3 && apt-get install -y --no-install-recommends -o Acquire::Retries=3 iptables && command -v iptables) \
      || echo "!!! iptables install FAILED — HXCTF_EGRESS=locked 将 fail-closed 拒绝起跑;需修好 iptables 或设 HXCTF_EGRESS=open"
COPY engine /app/engine
COPY solver /app/solver
COPY kb-extra /opt/kb/extra
RUN chmod -R o+rX /opt/kb/extra 2>/dev/null || true
RUN chmod +x /app/solver/run.sh; \
    pip3 install --break-system-packages tsec-benchmark \
      || pip3 install --break-system-packages -i https://mirrors.ustc.edu.cn/pypi/web/simple tsec-benchmark \
      || pip3 install --break-system-packages -i https://mirrors.aliyun.com/pypi/simple/ tsec-benchmark
RUN pip3 install --break-system-packages --ignore-installed click \
      || pip3 install --break-system-packages --ignore-installed -i https://mirrors.ustc.edu.cn/pypi/web/simple click; \
    pip3 install --break-system-packages semgrep \
      || pip3 install --break-system-packages -i https://mirrors.ustc.edu.cn/pypi/web/simple semgrep \
      || pip3 install --break-system-packages -i https://mirrors.aliyun.com/pypi/simple/ semgrep \
      || echo "semgrep skipped (finding-source will fail-closed)"
ARG MSF_REPO=https://github.com/rapid7/metasploit-framework.git
RUN set -e; mkdir -p /opt/msf-modules; \
    git config --global http.version HTTP/1.1; \
    git config --global http.postBuffer 1048576000; \
    _ok=0; \
    for a in 1 2 3 4 5 6 7 8; do \
      rm -rf /tmp/msf; \
      if [ $((a % 2)) -eq 0 ]; then P="-c http.proxy=http://host.docker.internal:7897 -c https.proxy=http://host.docker.internal:7897"; else P="-c http.proxy= -c https.proxy="; fi; \
      if git $P clone --depth 1 --filter=blob:none --sparse "${MSF_REPO}" /tmp/msf \
         && git $P -C /tmp/msf sparse-checkout set modules/exploits modules/auxiliary \
         && [ -n "$(find /tmp/msf/modules/exploits -name '*.rb' 2>/dev/null | head -1)" ]; then _ok=1; echo "[msf] clone OK on attempt $a"; break; fi; \
      echo "[msf] attempt $a failed, retry"; sleep 4; \
    done; \
    if [ "$_ok" = 1 ]; then \
      cp -r /tmp/msf/modules/exploits /tmp/msf/modules/auxiliary /opt/msf-modules/; \
      ( cp /tmp/msf/LICENSE /opt/msf-modules/LICENSE 2>/dev/null || true ); \
      rm -rf /tmp/msf; \
    else echo "!!! MSF clone skipped after 8 retries (S1 expsearch will report missing index)"; fi; \
    cp /app/engine/expsearch.py /opt/expsearch.py; \
    ( python3 /opt/expsearch.py --build /opt/msf-modules > /opt/msf-index.json \
      && echo "expsearch index: $(python3 -c 'import json;print(len(json.load(open("/opt/msf-index.json"))))') modules" \
      || echo "expsearch index build skipped" ); \
    printf '#!/bin/sh\nexec python3 /opt/expsearch.py "$@" --index /opt/msf-index.json\n' > /usr/local/bin/expsearch; \
    chmod +x /usr/local/bin/expsearch; \
    chmod -R o+rX /opt/msf-modules /opt/expsearch.py /opt/msf-index.json 2>/dev/null || true
RUN cp /app/engine/xform_solve.py /opt/xform_solve.py; \
    printf '#!/bin/sh\nexec python3 /opt/xform_solve.py "$@"\n' > /usr/local/bin/xform-solve; \
    chmod +x /usr/local/bin/xform-solve; chmod o+rX /opt/xform_solve.py 2>/dev/null || true
RUN chmod -R o-rwx /app
ENV IS_SANDBOX=1 PYTHONUNBUFFERED=1


RUN rm -rf /usr/share/seclists; \
    ( git clone --depth 1 https://github.com/danielmiessler/SecLists.git /usr/share/seclists 2>/dev/null \
      || git clone --depth 1 https://gitee.com/mirrors/SecLists.git /usr/share/seclists 2>/dev/null ) \
    && rm -rf /usr/share/seclists/.git \
    && echo "SecLists ok: $(du -sh /usr/share/seclists 2>/dev/null | cut -f1)" \
    || echo "!!! SecLists clone 失败(非致命;执行器仍有 /opt/kb/PayloadsAllTheThings)"
RUN RY=/usr/share/seclists/Passwords/Leaked-Databases/rockyou.txt.tar.gz; \
    if [ -f "$RY" ]; then rm -f /usr/share/wordlists/rockyou.txt; \
      tar -xzf "$RY" -C /usr/share/wordlists/ \
      && echo "rockyou 全量: $(wc -l </usr/share/wordlists/rockyou.txt 2>/dev/null) 行"; \
    else echo "SecLists 无 rockyou.tar.gz,保留 base top1m 软链"; fi
RUN set -e; \
    git config --global http.version HTTP/1.1; \
    git config --global http.postBuffer 1048576000; \
    _ok=0; \
    for a in 1 2 3 4 5 6; do \
      if [ $((a % 2)) -eq 0 ]; then P="-c http.proxy=http://host.docker.internal:7897 -c https.proxy=http://host.docker.internal:7897"; else P="-c http.proxy= -c https.proxy="; fi; \
      for repo in https://gitlab.com/exploit-database/exploitdb.git https://github.com/offensive-security/exploitdb.git; do \
        rm -rf /usr/share/exploitdb; \
        if git $P clone --depth 1 "$repo" /usr/share/exploitdb && [ -f /usr/share/exploitdb/files_exploits.csv ]; then \
          _ok=1; echo "[exploitdb] clone OK: $repo (attempt $a)"; break 2; fi; \
        echo "[exploitdb] $repo attempt $a failed"; \
      done; \
      sleep 4; \
    done; \
    if [ "$_ok" = 1 ]; then \
      rm -rf /usr/share/exploitdb/.git; \
      ln -sf /usr/share/exploitdb/searchsploit /usr/local/bin/searchsploit; \
      printf 'DB_PATH="/usr/share/exploitdb"\n' > /root/.searchsploit_rc; \
      echo "exploitdb ok: $(du -sh /usr/share/exploitdb 2>/dev/null | cut -f1)"; \
    else echo "!!! exploitdb clone 失败(非致命;MSF/nuclei/kb 覆盖)"; fi
RUN pip3 install --break-system-packages pyjwt cryptography pycryptodomex termcolor cprint requests ratelimit 2>/dev/null || true; \
    [ -f /opt/jwt_tool/jwt_tool.py ] || git clone --depth 1 https://github.com/ticarpi/jwt_tool.git /opt/jwt_tool 2>/dev/null || true; \
    [ -f /opt/jwt_tool/requirements.txt ] && pip3 install --break-system-packages -r /opt/jwt_tool/requirements.txt 2>/dev/null || true; \
    if [ -f /opt/jwt_tool/jwt_tool.py ]; then \
      printf '#!/bin/sh\nexec python3 /opt/jwt_tool/jwt_tool.py "$@"\n' > /usr/local/bin/jwt_tool; \
      chmod +x /usr/local/bin/jwt_tool; fi; \
    for pp in /usr/local/lib/python3.*/dist-packages; do chmod -R o+rX "$pp" 2>/dev/null || true; done
RUN if [ ! -f /usr/share/exploitdb/files_exploits.csv ]; then \
      rm -rf /usr/share/exploitdb /usr/local/bin/searchsploit /root/.searchsploit_rc; \
      echo "exploitdb 不可达 → 清空桩"; fi
RUN chmod -R o+rX /usr/share/seclists /usr/share/exploitdb /usr/share/wordlists /opt/jwt_tool 2>/dev/null || true; \
    chmod o+rx /usr/local/bin/searchsploit /usr/local/bin/jwt_tool 2>/dev/null || true

RUN (apt-get update -o Acquire::Retries=2 2>&1 | tail -1 || true); \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        bc iproute2 traceroute lua5.4 2>&1 | tail -3 || echo "[kb3] apt 部分失败(降级:python/nc 兜底)"; \
    apt-get clean; rm -rf /var/lib/apt/lists/*
RUN pip3 install --break-system-packages --no-cache-dir \
        pydash pymysql pytesseract Pillow flask-unsign keystone-engine 2>&1 | tail -4 || true; \
    for pp in /usr/local/lib/python3.*/dist-packages; do chmod -R o+rX "$pp" 2>/dev/null || true; done; \
    command -v flask-unsign >/dev/null 2>&1 && chmod o+rx "$(command -v flask-unsign)" 2>/dev/null || true

RUN pip3 install --break-system-packages --no-cache-dir \
        tqdm websocket-client base58 word2number PyMuPDF 2>&1 | tail -3 || true; \
    ( pip3 install --break-system-packages --no-cache-dir pickora 2>/dev/null \
      || pip3 install --break-system-packages --no-cache-dir "git+https://github.com/splitline/Pickora.git" 2>/dev/null ) || true; \
    for pp in /usr/local/lib/python3.*/dist-packages; do chmod -R o+rX "$pp" 2>/dev/null || true; done

RUN (apt-get update -o Acquire::Retries=2 2>&1 | tail -1 || true); \
    (apt-get install -y --no-install-recommends sox 2>&1 | tail -2 || echo "[kb5] sox apt 失败(降级)"); \
    apt-get clean; rm -rf /var/lib/apt/lists/* 2>/dev/null || true
RUN pip3 install --break-system-packages --no-cache-dir \
        ortools cheb3 solana solders 2>&1 | tail -4 || true; \
    for pp in /usr/local/lib/python3.*/dist-packages; do chmod -R o+rX "$pp" 2>/dev/null || true; done

COPY kb-extra/crypto-attacks /opt/kb/crypto-attacks
COPY kb-extra/lang-jails /opt/kb/extra/lang-jails
COPY kb-extra/web-logic /opt/kb/web-logic
RUN chmod -R o+rX /opt/kb/crypto-attacks /opt/kb/extra/lang-jails /opt/kb/web-logic; \
    chmod 0755 /opt/kb/crypto-attacks/length_extension.py; \
    ln -sf /opt/kb/crypto-attacks/length_extension.py /usr/local/bin/length-extension
RUN pip3 install --break-system-packages --no-cache-dir pyfinite 2>&1 | tail -2 || true
RUN rm -rf /opt/RsaCtfTool /usr/local/bin/RsaCtfTool /usr/local/bin/rsacrack; \
    ( git clone --depth 1 https://github.com/RsaCtfTool/RsaCtfTool.git /opt/RsaCtfTool 2>/dev/null \
      || git clone --depth 1 https://gitee.com/mirrors/RsaCtfTool.git /opt/RsaCtfTool 2>/dev/null ) \
    && rm -rf /opt/RsaCtfTool/.git \
    && ( pip3 install --break-system-packages --no-cache-dir /opt/RsaCtfTool 2>&1 | tail -3 ) \
    && chmod -R o+rX /opt/RsaCtfTool \
    || echo "[kb6] RsaCtfTool 取用失败(降级:手写 RSA 攻击,见 /opt/kb/crypto-attacks/02)"
RUN (apt-get update -o Acquire::Retries=2 2>&1 | tail -1 || true); \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends pike8.0 2>&1 | tail -3 \
    || echo "[kb6] pike8.0 apt 失败(降级:Pike 牢逸页仍在,现场可 apt 补)"; \
    apt-get clean; rm -rf /var/lib/apt/lists/*
RUN for pp in /usr/local/lib/python3.*/dist-packages; do chmod -R o+rX "$pp" 2>/dev/null || true; done
RUN { echo "# ---- technique handbook (added) ----"; \
      find /opt/kb/crypto-attacks /opt/kb/extra/lang-jails /opt/kb/web-logic -type f 2>/dev/null | sed 's#/opt/kb/##' | sort; } >> /opt/kb/INDEX.txt; \
    chmod o+r /opt/kb/INDEX.txt
COPY engine/kb_search.py /opt/kb_search.py
RUN chmod o+rX /opt/kb_search.py; \
    ( python3 /opt/kb_search.py --build /opt/kb > /opt/kb-index.json 2>/dev/null \
      && echo "kb-index: $(python3 -c 'import json;print(len(json.load(open("/opt/kb-index.json"))))') files" \
      || echo "[kb6] kb-index 构建失败(降级:执行器仍可 grep /opt/kb / cat INDEX.txt)" ); \
    chmod o+rX /opt/kb-index.json 2>/dev/null || true; \
    printf '#!/bin/sh\nexec python3 /opt/kb_search.py "$@" --index /opt/kb-index.json --kb-root /opt/kb\n' > /usr/local/bin/kb; \
    chmod +x /usr/local/bin/kb

RUN chmod -R o-rwx /app 2>/dev/null || true; \
    find /app -name __pycache__ -type d -exec rm -rf {} + 2>/dev/null || true
ENV PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    LANG=C.UTF-8 \
    DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    NODE_VERSION=20.18.1 \
    DOTNET_ROOT=/usr/share/dotnet \
    IS_SANDBOX=1 \
    TERM=xterm \
    HXCTF_EGRESS=open \
    HXCTF_LLM_EGRESS=tsecbench
WORKDIR /app
ENTRYPOINT ["/app/solver/run.sh"]
