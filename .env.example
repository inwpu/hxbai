# hxbai runtime config — copy to .env and fill in. Single model end-to-end (solver = verifier).

# ── answer API (platform-issued; hand-filled for local pre-eval, auto-injected when hosted) ──
BENCHMARK_TOKEN=<platform-issued token>
BENCHMARK_BASE_URL=<platform-issued base url, e.g. https://tsecbench.example.com>

# ── model (single provider end-to-end): deepseek(flash) / deepseek-1m / glm / glm-1m ──
HXBAI_PROVIDER=deepseek
SOLVER_API_KEY=<your-deepseek-api-key>

# ── official competition run config (the exact settings used on Tsecbench v1) ──
SOLVER_GATEWAY=1            # hosted gateway: rewrite API host to http://<host>.tsecbench.gw, https->http
HXBAI_USE_PRO=0            # 0 = deepseek-v4-flash (no reasoning, cheap/fast); 1 = pro variant
HXBAI_USE_HINTS=1          # opt-in platform hints, gated (never on easy, only on a stuck revisit)
HXBAI_ROUTE_BY_CATEGORY=0  # 0 = shape-based routing (file magic > protocol > banner > wording)
HXBAI_WORKING_SET=3        # challenges actively worked in parallel
HXBAI_KEEPALIVE_MAX=2      # instance keepalive quota (0 = off, fallback stays on)
HXBAI_MAX_CONCURRENCY=3    # parallel challenges (aligned to the platform active-instance cap)
HXBAI_HANDOFF_LLM=1        # use the LLM to synthesize the cross-visit handoff (0 = code-only fallback)
HXBAI_PERSIST_AUTOCARD=0   # persist auto-generated knowledge cards after a full solve
HXBAI_VPN_KEEPALIVE=1      # keep the in-container VPN tunnel warm (ping / ping-restart)
HXBAI_TOTAL_SECONDS=21300  # overall wall-clock budget (no new round started past this)
HXBAI_ROUND_TIMEBOXES=480,820,1500,2000  # per-round per-challenge visit seconds (escalating); rounds = count
HXBAI_INNER_LANES=1        # inner lanes for a multi-flag chain (1 = disabled, 2 = parallel)
HXBAI_WORKDIR=/work        # per-challenge working directories root
